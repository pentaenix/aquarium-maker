{
  "name": "aquarium-maker",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "kernel:browser": "node scripts/aquarium-kernel/build-browser-wasm.mjs",
    "dev": "npm run kernel:browser && vite",
    "build": "npm run kernel:browser && tsc --noEmit && vite build && node scripts/sync-build.mjs && node scripts/make-standalone.mjs",
    "preview": "vite preview",
    "check": "npm run kernel:browser && tsc --noEmit && vite build",
    "validate:model": "npm run kernel:browser && tsx scripts/validate-model.ts",
    "validate:kernel": "node scripts/aquarium-kernel/verify-wasm.mjs"
  },
  "dependencies": {
    "polygon-clipping": "^0.15.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  }
}
